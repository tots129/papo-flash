rules_version = '2';

// Regras de segurança do Papo Flash.
// Cole tudo isto em Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function myEmail() { return request.auth.token.get('email', '').lower(); }
    function myPhone() { return request.auth.token.get('phone_number', ''); }
    // e-mail confiável: confirmado, ou vindo do Google/Microsoft/Yahoo
    function trustedEmail() {
      return myEmail() != ''
        && (request.auth.token.get('email_verified', false) == true
          || request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com', 'yahoo.com']);
    }
    function emailOk(v) { return v == (trustedEmail() ? myEmail() : ''); }
    function phoneOk(v) { return v == myPhone(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function convDoc(cid) { return get(/databases/$(database)/documents/conversations/$(cid)).data; }
    function blockedBy(uid) { return me() in userDoc(uid).data.get('blocked', []); }
    function otherOf(c) { return c.members[0] == me() ? c.members[1] : c.members[0]; }

    // ---------------------------------------------------------- perfis
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'photo', 'email', 'phone', 'lastActive', 'createdAt', 'blocked'])
        && str(request.resource.data.name, 1, 80)
        && emailOk(request.resource.data.get('email', ''))
        && phoneOk(request.resource.data.get('phone', ''))
        && request.resource.data.blocked is list && request.resource.data.blocked.size() == 0;
      allow update: if signedIn() && uid == me()
        && changed().hasOnly(['name', 'photo', 'email', 'phone', 'lastActive', 'blocked'])
        && str(request.resource.data.name, 1, 80)
        && emailOk(request.resource.data.get('email', ''))
        && phoneOk(request.resource.data.get('phone', ''))
        && request.resource.data.blocked is list && request.resource.data.blocked.size() <= 500;
      allow delete: if false;
    }

    // e-mail → uid (só para achar alguém pelo e-mail exato; não dá para listar)
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && trustedEmail() && email == myEmail()
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me();
      allow delete: if false;
    }

    // celular → uid (só para quem entrou pelo número)
    match /phones/{phone} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && myPhone() != '' && phone == myPhone()
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me();
      allow delete: if false;
    }

    // ---------------------------------------------------------- conversas
    match /conversations/{cid} {
      function isMember() { return me() in resource.data.members; }
      function isSpaceAdmin() { return resource.data.type == 'space' && me() in resource.data.get('admins', []); }
      function onlyMyKey(field) {
        return !(field in changed())
          || request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([me()]);
      }
      function lastMessageOk() {
        return !('lastMessage' in changed())
          || (request.resource.data.lastMessage.by == me() && str(request.resource.data.lastMessage.text, 0, 400));
      }
      function dmOpen() {
        return resource.data.type != 'dm' || !blockedBy(otherOf(resource.data));
      }

      // ler: quem é membro (ou checar se uma conversa nova ainda não existe)
      allow get: if signedIn() && (resource == null || isMember());
      allow list: if signedIn() && me() in resource.data.members;

      allow create: if signedIn() && request.resource.data.createdBy == me() && (
        // conversa direta entre duas pessoas
        (request.resource.data.type == 'dm'
          && request.resource.data.keys().hasOnly(['type', 'members', 'createdBy', 'createdAt', 'lastMessageAt', 'reads', 'typing'])
          && request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] < request.resource.data.members[1]
          && me() in request.resource.data.members
          && cid == 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1]
          && exists(/databases/$(database)/documents/users/$(otherOf(request.resource.data)))
          && !blockedBy(otherOf(request.resource.data)))
        ||
        // espaço (grupo): começa só com quem criou
        (request.resource.data.type == 'space'
          && request.resource.data.keys().hasOnly(['type', 'name', 'emoji', 'description', 'members', 'admins', 'createdBy', 'createdAt', 'lastMessageAt', 'reads', 'typing'])
          && request.resource.data.members == [me()]
          && request.resource.data.admins == [me()]
          && str(request.resource.data.name, 1, 60)
          && str(request.resource.data.get('emoji', ''), 0, 16)
          && str(request.resource.data.get('description', ''), 0, 400))
      );

      allow update: if signedIn() && (
        // membro: última mensagem, "lido" e "digitando" (só os próprios)
        (isMember()
          && changed().hasOnly(['lastMessage', 'lastMessageAt', 'reads', 'typing'])
          && onlyMyKey('reads') && onlyMyKey('typing') && lastMessageOk() && dmOpen())
        ||
        // admin do espaço: nome, emoji, descrição, membros e admins
        (isSpaceAdmin()
          && changed().hasOnly(['name', 'emoji', 'description', 'members', 'admins', 'lastMessage', 'lastMessageAt', 'reads', 'typing', 'joinCode'])
          && str(request.resource.data.name, 1, 60)
          && str(request.resource.data.get('emoji', ''), 0, 16)
          && str(request.resource.data.get('description', ''), 0, 400)
          && request.resource.data.members is list
          && request.resource.data.admins is list
          && request.resource.data.members.hasAll(request.resource.data.admins)
          && request.resource.data.members.size() <= 500)
        ||
        // sair do espaço
        (isMember() && resource.data.type == 'space'
          && changed().hasOnly(['members', 'admins'])
          && request.resource.data.members == resource.data.members.removeAll([me()])
          && request.resource.data.admins == resource.data.get('admins', []).removeAll([me()]))
        ||
        // entrar com convite
        (resource.data.type == 'space' && !isMember()
          && changed().hasOnly(['members', 'joinCode'])
          && request.resource.data.members == resource.data.members.concat([me()])
          && resource.data.members.size() < 500
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinCode))
          && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.cid == cid)
      );

      allow delete: if signedIn() && isSpaceAdmin();

      // ------------------------------------------------------ mensagens
      match /messages/{mid} {
        function conv() { return convDoc(cid); }
        function member() { return me() in conv().members; }
        function canTalk() { return conv().type != 'dm' || !blockedBy(otherOf(conv())); }
        function replyOk() {
          return !('replyTo' in request.resource.data)
            || (request.resource.data.replyTo.keys().hasOnly(['id', 'by', 'text'])
              && str(request.resource.data.replyTo.text, 0, 400));
        }

        allow read: if signedIn() && member();

        allow create: if signedIn() && member() && canTalk()
          && request.resource.data.keys().hasOnly(['text', 'by', 'at', 'replyTo'])
          && request.resource.data.by == me()
          && request.resource.data.at == request.time
          && str(request.resource.data.text, 1, 4000)
          && replyOk();

        allow update: if signedIn() && member() && (
          // quem escreveu: editar ou apagar
          (resource.data.by == me()
            && resource.data.get('deleted', false) != true
            && changed().hasOnly(['text', 'editedAt', 'deleted'])
            && request.resource.data.editedAt == request.time
            && (request.resource.data.get('deleted', false) == true
              ? request.resource.data.text == ''
              : str(request.resource.data.text, 1, 4000)))
          ||
          // qualquer membro: reagir (um emoji por vez)
          (changed().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().size() == 1
            && request.resource.data.reactions.size() <= 40)
        );

        allow delete: if signedIn() && conv().type == 'space' && me() in conv().get('admins', []);
      }
    }

    // ---------------------------------------------------------- convites
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.size() == 10
        && request.resource.data.keys().hasOnly(['cid', 'name', 'emoji', 'by', 'at'])
        && request.resource.data.by == me()
        && me() in convDoc(request.resource.data.cid).get('admins', []);
      allow update: if false;
      allow delete: if signedIn() && me() in convDoc(resource.data.cid).get('admins', []);
    }

    // ---------------------------------------------------------- denúncias
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['by', 'cid', 'mid', 'author', 'text', 'reason', 'at'])
        && str(request.resource.data.get('text', ''), 0, 2000)
        && str(request.resource.data.get('reason', ''), 0, 200);
      allow read, update, delete: if false;
    }

    // todo o resto: fechado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
